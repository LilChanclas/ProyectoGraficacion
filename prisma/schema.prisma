generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Proyecto {
  id             String      @id @default(cuid())
  nombre         String
  descripcion    String?
  creado_en      DateTime    @default(now())
  actualizado_en DateTime    @updatedAt
  personas       Persona[]
  procesos       Proceso[]
  roles          Rol[]
  requisitos     Requisito[]
  diagramas      Diagrama[]
  specs          Spec[]
}

model Spec {
  id             String   @id @default(cuid())
  proyecto_id    String
  nombre         String
  descripcion    String?
  contenido      String
  creado_en      DateTime @default(now())
  actualizado_en DateTime @updatedAt
  proyecto       Proyecto @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)

  @@index([proyecto_id])
}

model Diagrama {
  id             String       @id @default(cuid())
  proyecto_id    String
  tipo           TipoDiagrama
  nombre         String
  contenido      String
  creado_en      DateTime     @default(now())
  actualizado_en DateTime     @updatedAt
  proyecto       Proyecto     @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)

  @@index([proyecto_id])
}

enum TipoDiagrama {
  PAQUETES
  CLASES
  CASOS_USO
  SECUENCIA
}

model Rol {
  id          String    @id @default(cuid())
  proyecto_id String
  nombre      String
  personas    Persona[]
  proyecto    Proyecto  @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)

  @@unique([proyecto_id, nombre])
  @@index([proyecto_id])
}

model Persona {
  id                   String               @id @default(cuid())
  proyecto_id          String
  rol_id               String
  nombre_completo      String
  correo               String?
  telefono             String?
  notas                String?
  creado_en            DateTime             @default(now())
  proyecto             Proyecto             @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  rol                  Rol                  @relation(fields: [rol_id], references: [id])
  sesion_participantes SesionParticipante[]
  respuestas           RespuestaPregunta[]

  @@index([proyecto_id])
  @@index([rol_id])
}

model Proceso {
  id          String       @id @default(cuid())
  proyecto_id String
  nombre      String
  descripcion String?
  proyecto    Proyecto     @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  subprocesos Subproceso[]

  @@unique([proyecto_id, nombre])
  @@index([proyecto_id])
}

model Subproceso {
  id                  String              @id @default(cuid())
  proceso_id          String
  nombre              String
  descripcion         String?
  proceso             Proceso             @relation(fields: [proceso_id], references: [id], onDelete: Cascade)
  subproceso_tecnicas SubprocesoTecnica[]
  sesiones            SesionRecabacion[]

  @@unique([proceso_id, nombre])
  @@index([proceso_id])
}

model Tecnica {
  id                  String              @id @default(cuid())
  nombre              String
  tipo_metodo         TipoMetodoTecnica
  descripcion         String?
  subproceso_tecnicas SubprocesoTecnica[]
  sesiones            SesionRecabacion[]
}

model SubprocesoTecnica {
  subproceso_id String
  tecnica_id    String
  subproceso    Subproceso @relation(fields: [subproceso_id], references: [id], onDelete: Cascade)
  tecnica       Tecnica    @relation(fields: [tecnica_id], references: [id], onDelete: Cascade)

  @@id([subproceso_id, tecnica_id])
  @@index([tecnica_id])
}

model SesionRecabacion {
  id            String               @id @default(cuid())
  subproceso_id String
  tecnica_id    String
  fecha         DateTime
  estado        EstadoSesion         @default(PENDIENTE)
  notas         String?
  creado_en     DateTime             @default(now())
  subproceso    Subproceso           @relation(fields: [subproceso_id], references: [id], onDelete: Cascade)
  tecnica       Tecnica              @relation(fields: [tecnica_id], references: [id])
  participantes SesionParticipante[]
  resultados    ResultadoRecabacion[]
  preguntas     PreguntaSesion[]

  @@index([subproceso_id])
  @@index([tecnica_id])
}

model PreguntaSesion {
  id         String              @id @default(cuid())
  sesion_id  String
  texto      String
  orden      Int                 @default(0)
  creado_en  DateTime            @default(now())
  sesion     SesionRecabacion    @relation(fields: [sesion_id], references: [id], onDelete: Cascade)
  respuestas RespuestaPregunta[]

  @@index([sesion_id])
}

model RespuestaPregunta {
  id          String         @id @default(cuid())
  pregunta_id String
  persona_id  String?
  respuesta   String
  creado_en   DateTime       @default(now())
  pregunta    PreguntaSesion @relation(fields: [pregunta_id], references: [id], onDelete: Cascade)
  persona     Persona?       @relation(fields: [persona_id], references: [id], onDelete: SetNull)

  @@index([pregunta_id])
  @@index([persona_id])
}

model SesionParticipante {
  sesion_id  String
  persona_id String
  sesion     SesionRecabacion @relation(fields: [sesion_id], references: [id], onDelete: Cascade)
  persona    Persona          @relation(fields: [persona_id], references: [id], onDelete: Cascade)

  @@id([sesion_id, persona_id])
  @@index([persona_id])
}

model ResultadoRecabacion {
  id                String            @id @default(cuid())
  sesion_id         String
  contenido         String
  notas             String?
  creado_en         DateTime          @default(now())
  sesion            SesionRecabacion  @relation(fields: [sesion_id], references: [id], onDelete: Cascade)
  requisito_fuentes RequisitoFuente[]

  @@index([sesion_id])
}

model Requisito {
  id             String             @id @default(cuid())
  proyecto_id    String
  codigo         String?
  nombre         String
  descripcion    String?
  prioridad      PrioridadRequisito @default(MEDIA)
  estado         EstadoRequisito    @default(PENDIENTE)
  creado_en      DateTime           @default(now())
  actualizado_en DateTime           @updatedAt
  proyecto       Proyecto           @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  fuentes        RequisitoFuente[]

  @@index([proyecto_id])
}

model RequisitoFuente {
  requisito_id String
  resultado_id String
  requisito    Requisito           @relation(fields: [requisito_id], references: [id], onDelete: Cascade)
  resultado    ResultadoRecabacion @relation(fields: [resultado_id], references: [id], onDelete: Cascade)

  @@id([requisito_id, resultado_id])
  @@index([resultado_id])
}

enum TipoMetodoTecnica {
  ENTREVISTA
  CUESTIONARIO
  OBSERVACION
  HISTORIA_USUARIO
  FOCUS_GROUP
  DOCUMENTOS
  SEGUIMIENTO_TRANSACCIONAL
}

enum EstadoSesion {
  PENDIENTE
  EN_CURSO
  COMPLETADA
  CANCELADA
}

enum PrioridadRequisito {
  ALTA
  MEDIA
  BAJA
}

enum EstadoRequisito {
  PENDIENTE
  VALIDADO
  DESCARTADO
}
